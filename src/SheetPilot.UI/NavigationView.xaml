<UserControl x:Class="SheetPilot.UI.NavigationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SheetPilot.UI" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CanvasBrush}" MinWidth="240" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown" PreviewMouseDown="PaneMouseDown" ToolTipOpening="OnToolTipOpening">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="{DynamicResource AccentBrush}" Padding="12,7" Visibility="{Binding Settings.ShowHeader, Converter={StaticResource BoolVisibility}}"><DockPanel><TextBlock Text="GridPilot" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/><TextBlock Text="工作表导航" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" FontSize="10"/></DockPanel></Border>
<Grid Grid.Row="1" Visibility="{Binding IsNavigationOpen, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="10,10,10,0">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
<ComboBox SelectedIndex="{Binding ScopeIndex}" MinWidth="80" MinHeight="28" Padding="3,3" FontSize="11"><ComboBoxItem Content="当前工作簿"/><ComboBoxItem Content="全部工作簿"/></ComboBox>
<Button x:Name="QuickSortButton" Grid.Column="1" Content="↑" Padding="0" Margin="2,0,0,0" FontSize="17" Click="QuickSortClick" AutomationProperties.Name="一键切换升降序"/>
<Button Grid.Column="2" Padding="0" Margin="2,0,0,0" Click="SortClick" ToolTip="高级排序 · 自定义序列与正则" AutomationProperties.Name="高级排序"><Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Data="M 2,2 L 2,14 M 0,12 L 2,14 4,12 M 7,3 L 11,3 M 7,8 L 14,8 M 7,13 L 17,13"/></Button>
<Button Grid.Column="3" Content="↻" FontSize="16" Padding="0" Margin="2,0,0,0" Click="RefreshClick" ToolTip="刷新（F5）" AutomationProperties.Name="刷新目录"/>
<Button Grid.Column="4" Padding="0" Margin="2,0,0,0" Click="SettingsClick" ToolTip="设置" AutomationProperties.Name="导航设置"><Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Data="M 1,3 L 15,3 M 1,8 L 15,8 M 1,13 L 15,13 M 5,0 L 5,6 M 11,5 L 11,11 M 5,10 L 5,16"/></Button>
</Grid>
<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" BorderThickness="0" Background="Transparent" FontSize="13" AutomationProperties.Name="搜索工作表名称"/>
<TextBlock Text="搜索工作表…" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<Button x:Name="ClearButton" Grid.Column="1" Content="×" Padding="3,0" BorderThickness="0" Click="ClearClick" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="清空搜索（Esc）"/>
</Grid></Border>

<DockPanel Margin="0,7,0,6"><WrapPanel>
<ToggleButton Content=".*" Padding="8,4" IsChecked="{Binding UseRegex}" Margin="0,0,5,0" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="正则表达式：^销售|汇总$" AutomationProperties.Name="正则搜索"/>
<ToggleButton Content="Aa" Padding="8,4" IsChecked="{Binding MatchCase}" Margin="0,0,5,0" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="区分大小写"/>
<ToggleButton Content="隐藏页" Padding="8,4" IsChecked="{Binding IncludeHidden}" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="包含隐藏与深度隐藏页"/>
</WrapPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0"/></DockPanel>
<TextBlock Text="设置提示 · 点击「设置」查看" Foreground="#A27535" FontSize="10" Margin="0,1,0,5" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="{Binding SettingsStatus}" Visibility="{Binding SettingsSaveFailed, Converter={StaticResource BoolVisibility}}"/>
<Border Background="#FFF0DD" CornerRadius="5" Padding="9,7" Margin="0,2,0,7" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Message}" Foreground="#895820" TextWrapping="Wrap"/></Border>
</StackPanel>
<Grid Grid.Row="1" Margin="6,0">
<ListBox x:Name="SheetList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseLeftButtonUp="SheetClick" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" PreviewMouseRightButtonDown="SelectContextRow" ContextMenuOpening="OpenSheetMenu" AllowDrop="True" DragOver="SheetDragOver" DragLeave="SheetDragLeave" Drop="SheetDrop" AutomationProperties.Name="工作表目录">
<ListBox.ContextMenu><ContextMenu><MenuItem Header="工作表操作"/></ContextMenu></ListBox.ContextMenu><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
<Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="{Binding DataContext.EffectiveRowHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/><Setter Property="Margin" Value="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="7,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
<Trigger Property="Tag" Value="DropBefore"><Setter TargetName="Row" Property="BorderThickness" Value="0,2,0,0"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="Tag" Value="DropAfter"><Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}">
<Grid.ToolTip><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkbookName}"/><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Hint}"/></StackPanel></Grid.ToolTip>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Number}" Width="24" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="{Binding DataContext.Settings.ShowSheetNumbers, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}"/>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SheetNameLabel" Text="{Binding Name}" FontSize="{Binding DataContext.Settings.FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" TextTrimming="CharacterEllipsis"/>
<TextBox x:Name="InlineName" Visibility="Collapsed" MaxLength="31" PreviewKeyDown="InlineKey" LostKeyboardFocus="InlineBlur" ContextMenuOpening="InlineMenu" Padding="1,0"><TextBox.ContextMenu><ContextMenu><MenuItem Header="编辑名称"/></ContextMenu></TextBox.ContextMenu></TextBox>
<TextBlock Text="{Binding WorkbookName}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding DataContext.ShowWorkbookNames, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
<DataTrigger Binding="{Binding DataContext.Settings.ShowSheetType, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
<DataTrigger Binding="{Binding Kind}" Value="图表页"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
<DataTrigger Binding="{Binding CanNavigate}" Value="False"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#A17B3C"/></DataTrigger>
</Style.Triggers></Style></TextBlock.Style></TextBlock>
<Border Grid.Column="3" Width="5" Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="当前页面"/>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="◇" FontSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/><TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center"/><TextBlock Text="{Binding EmptyHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/></StackPanel>
</Grid>
<Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="11,7" Visibility="{Binding Settings.ShowFooter, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding WorkbookName}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource MutedBrush}" ToolTipService.IsEnabled="{Binding DataContext.Settings.ShowTooltips, RelativeSource={RelativeSource AncestorType=local:NavigationView}}" ToolTip="{Binding WorkbookName}"/><TextBlock Text="单击跳转 · 双击/F2 改名 · Enter 完成 · Esc 取消" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" Visibility="{Binding Settings.ShowKeyboardHints, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
</Grid>
<Grid Grid.Row="1" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="12,12,12,8"><Button Content="← 返回" Click="BackClick" Padding="8,4"/><TextBlock Text="布局与偏好" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/></DockPanel>
<ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,0,16,12">
<TextBlock Text="布局" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/><TextBlock Text="停靠位置" Margin="0,0,0,6"/><ComboBox SelectedIndex="{Binding Settings.DockSide}" MinHeight="30" Padding="7,4"><ComboBoxItem Content="右侧（默认）"/><ComboBoxItem Content="左侧"/></ComboBox>
<local:NumberEditor x:Name="PaneWidthEditor" Caption="面板宽度" Minimum="260" Maximum="1600" Step="10" Value="{Binding Settings.PaneWidth, Mode=TwoWay}"/>
<TextBlock Text="结果列表" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/><local:NumberEditor x:Name="RowHeightEditor" Caption="行高" Minimum="28" Maximum="80" Step="1" Value="{Binding Settings.RowHeight, Mode=TwoWay}"/><local:NumberEditor x:Name="RowGapEditor" Caption="行间距" Minimum="0" Maximum="10" Step="1" Value="{Binding Settings.RowGap, Mode=TwoWay}"/><local:NumberEditor x:Name="FontSizeEditor" Caption="字号" Minimum="11" Maximum="18" Step="1" Value="{Binding Settings.FontSize, Mode=TwoWay}"/>
<TextBlock Text="工作簿名" Margin="0,12,0,6"/><ComboBox SelectedIndex="{Binding Settings.WorkbookNameMode}" MinHeight="30" Padding="7,4"><ComboBoxItem Content="自动 · 跨工作簿时显示"/><ComboBoxItem Content="始终显示"/><ComboBoxItem Content="始终隐藏"/></ComboBox>
<TextBlock Text="双行内容会保留最小行高，避免文字重叠。" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,2"/>
<CheckBox Content="显示页面序号" IsChecked="{Binding Settings.ShowSheetNumbers}" Margin="0,7"/><CheckBox Content="显示普通工作表类型" IsChecked="{Binding Settings.ShowSheetType}" Margin="0,7"/>
<TextBlock Text="隐藏状态和图表标记始终显示。" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
<TextBlock Text="界面" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/><CheckBox Content="显示品牌标题栏" IsChecked="{Binding Settings.ShowHeader}" Margin="0,7"/><CheckBox Content="显示底部工作簿信息" IsChecked="{Binding Settings.ShowFooter}" Margin="0,7"/><CheckBox Content="显示底部快捷键提示" IsChecked="{Binding Settings.ShowKeyboardHints}" Margin="0,7"/>
<CheckBox Content="显示悬停提示（含点击说明）" IsChecked="{Binding Settings.ShowTooltips}" Margin="0,7"/>
<TextBlock Text="配色" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/>
<UniformGrid Columns="3"><Button Content="浅绿" Tag="green" Click="PaletteClick" Margin="0,0,4,0"/><Button Content="浅灰" Tag="neutral" Click="PaletteClick" Margin="0,0,4,0"/><Button Content="深色" Tag="dark" Click="PaletteClick"/></UniformGrid>
<local:ColorEditor Caption="面板背景" Value="{Binding Settings.BackgroundColor, Mode=TwoWay}"/>
<local:ColorEditor Caption="控件底色" Value="{Binding Settings.SurfaceColor, Mode=TwoWay}"/>
<local:ColorEditor Caption="主要文字" Value="{Binding Settings.TextColor, Mode=TwoWay}"/>
<local:ColorEditor Caption="辅助文字" Value="{Binding Settings.MutedTextColor, Mode=TwoWay}"/>
<local:ColorEditor Caption="鼠标悬停高亮" Value="{Binding Settings.HoverColor, Mode=TwoWay}"/>
<local:ColorEditor Caption="强调色" Value="{Binding Settings.AccentColor, Mode=TwoWay}"/>
<TextBlock Text="支持 #RRGGBB 或简写 #RGB；Enter 确认，Esc 撤销输入。" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
<TextBlock Text="一键排序" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/>
<ComboBox SelectedIndex="{Binding Settings.QuickSortMode}" MinHeight="30"><ComboBoxItem Content="名称 A–Z（中文按拼音）"/><ComboBoxItem Content="自然顺序（表2 在表10 前）"/><ComboBoxItem Content="最近使用的自定义序列 / 正则"/></ComboBox>
<CheckBox Content="下一次点击使用降序" IsChecked="{Binding Settings.QuickSortDescending}" Margin="0,9"/>
<TextBlock Text="首行箭头一键排序，完成后切换下次方向。高级排序可编辑自定义规则。作用于所选工作簿的全部标签，包括隐藏页。" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
<TextBlock Text="同步" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"/><CheckBox Content="自动刷新目录" IsChecked="{Binding Settings.AutoRefresh}" Margin="0,7"/><local:NumberEditor x:Name="RefreshSecondsEditor" Caption="刷新间隔（秒）" Minimum="1" Maximum="10" Step="1" Value="{Binding Settings.RefreshSeconds, Mode=TwoWay}"/>
<TextBlock Text="搜索范围、正则、大小写与隐藏页选项也会记住。搜索词不保存。" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,10"/>
<Button Content="恢复默认设置" Click="ResetClick" HorizontalAlignment="Left" Margin="0,4,0,5"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,9"><TextBlock Text="{Binding SettingsStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Border>
</Grid></Grid></UserControl>
